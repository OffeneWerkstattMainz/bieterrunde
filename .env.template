DOMAIN=mydomain.xyz
LETSENCRYPT_EMAIL=admin@mydomain.xyz

CREATE_VOTING_ACCESS_CODE=somesecurecode
WEBLING_API_KEY=enter-key-here

# Mitgliedsanmeldung (Double-Opt-In), siehe README
# Webling-Gruppe des Anmeldeformulars (unbestätigt) und für bestätigte Anmeldungen
SIGNUP_PENDING_GROUP_ID=
SIGNUP_CONFIRMED_GROUP_ID=
# Empfänger der Meldung über bestätigte Anmeldungen, durch Komma getrennt
SIGNUP_NOTIFY_EMAILS=vorstand@mydomain.xyz
# Optional: Sekunden zwischen zwei Abfragen, Tage bis Erinnerung bzw. Löschung
#SIGNUP_INTERVAL=120
#SIGNUP_REMINDER_DAYS=3
#SIGNUP_EXPIRY_DAYS=14

# Mailversand (SMTP mit StartTLS)
SMTP_HOST=smtp.mydomain.xyz
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mydomain.xyz

# Number of web workers
WEB_CONCURRENCY=20

# Number of queue workers
WORKER_CONCURRENCY=3

# To enable the Caddy reverse proxy uncomment the following line
#COMPOSE_PROFILES=proxy

# Location of data files, default: ./data
#DATA_DIR=
